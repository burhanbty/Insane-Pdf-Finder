# Sunucu
PORT=3000
HOST=127.0.0.1

# Open Library kendi API'sini arayabilsin diye kimlik. Kullanici adi + e-posta.
# E-posta zorunlu; verilmezse istekler 1 istek/sn ile sinirlanir.
CONTACT_EMAIL=

# Google Books API anahtari. Bos ise kaynak atlanir.
# https://www.googleapis.com/books/v1/volumes?q=test
GOOGLE_BOOKS_API_KEY=

# Semantic Scholar API anahtari (bos ise endpoint'e yazilir, yavas olur).
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Unpaywall zorunlu e-posta ister.
CONTACT_EMAIL_UNPAYWALL=

# Opsiyonel: ozet icin LLM. Verilirse OpenAI uyumlu endpoint kullanilir,
# verilmezse extractive (ilk paragraflar) ozet kullanilir.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Kaynak dosyalari taranacak klasor (ozel kaynak eklemek icin)
SOURCES_DIR=./src/sources